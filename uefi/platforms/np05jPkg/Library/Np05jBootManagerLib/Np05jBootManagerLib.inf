  nubia_np05jPkg/nubia_np05j.dec

[LibraryClasses]
  AcpiTableUpdateLib
  BaseLib
  BaseMemoryLib
  BootGraphicsLib
  DebugLib
  DeviceBootManagerLib
  DevicePathLib
  MemoryAllocationLib
  MsBootOptionsLib
  Np05jBiosConfigLib
  Np05jSplashLib
  PcdLib
  PrintLib
  SecureBootHandlerLib
  UefiBootManagerLib
  UefiBootServicesTableLib
