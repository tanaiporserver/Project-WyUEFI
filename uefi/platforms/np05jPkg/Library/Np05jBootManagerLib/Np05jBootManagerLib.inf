[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = Np05jBootManagerLib
  FILE_GUID                      = A1E45106-9B1C-4F2A-8C3D-10054E503035
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = PlatformBootManagerLib|DXE_DRIVER

[Sources]
  Np05jBootManager.h
  Np05jBootManager.c
