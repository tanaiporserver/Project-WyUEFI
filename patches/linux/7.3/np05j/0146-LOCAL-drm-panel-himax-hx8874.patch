From: sunuefi-np05j <sunuefi-np05j@local>
Subject: [PATCH] drm/panel: add Himax HX8874 9.06-inch Dual-DSI DSC OLED panel driver

Add support for the Himax HX8874 2400x1504 Dual-DSI DSC 1.1 command-mode
OLED panel on nubia REDMAGIC Astra (NP05J), supporting 60/90/120/144/165 Hz
refresh rates and 16-bit MIPI DCS 0x51 backlight control.

---
diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index f368eb4a4..aaec238d4 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -273,6 +273,21 @@ config DRM_PANEL_HIMAX_HX8394
 
 	  If M is selected the module will be called panel-himax-hx8394.
 
+config DRM_PANEL_HIMAX_HX8874
+	tristate "Himax HX8874 9.06-inch Dual-DSI DSC OLED panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_HELPER
+	select DRM_DISPLAY_DSC_HELPER
+	select DRM_KMS_HELPER
+	help
+	  Say Y here if you want to enable support for the Himax HX8874
+	  9.06-inch 2400x1504 Dual-DSI DSC OLED command-mode panel found
+	  in the nubia REDMAGIC Astra (NP05J).
+
+	  If M is selected the module will be called panel-himax-hx8874.
+
 config DRM_PANEL_HYDIS_HV101HD1
 	tristate "Hydis HV101HD1 panel"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 0f920cff7..64520eb04 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -27,6 +27,7 @@ obj-$(CONFIG_DRM_PANEL_HIMAX_HX83112A) += panel-himax-hx83112a.o
 obj-$(CONFIG_DRM_PANEL_HIMAX_HX83112B) += panel-himax-hx83112b.o
 obj-$(CONFIG_DRM_PANEL_HIMAX_HX83121A) += panel-himax-hx83121a.o
 obj-$(CONFIG_DRM_PANEL_HIMAX_HX8394) += panel-himax-hx8394.o
+obj-$(CONFIG_DRM_PANEL_HIMAX_HX8874) += panel-himax-hx8874.o
 obj-$(CONFIG_DRM_PANEL_HYDIS_HV101HD1) += panel-hydis-hv101hd1.o
 obj-$(CONFIG_DRM_PANEL_ILITEK_ILI7807S) += panel-ilitek-ili7807s.o
 obj-$(CONFIG_DRM_PANEL_ILITEK_IL9322) += panel-ilitek-ili9322.o
diff --git a/drivers/gpu/drm/panel/panel-himax-hx8874.c b/drivers/gpu/drm/panel/panel-himax-hx8874.c
new file mode 100644
index 000000000..402fa79b9
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-himax-hx8874.c
@@ -0,0 +1,403 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * ไดรเวอร์จอ OLED Himax HX8874 ขนาด 9.06 นิ้ว (2400x1504) สำหรับ nubia REDMAGIC Astra (NP05J)
+ * รองรับ Bonded Dual-DSI Command Mode + DSC 1.1 (10 bpc / 8 bpp, slice 1200x4)
+ * และรีเฟรชเรต 60 / 90 / 120 / 144 / 165 Hz พร้อมปรับความสว่างผ่าน MIPI DCS 0x51 (16-bit)
+ *
+ * ค่าพารามิเตอร์ทั้งหมดเทียบตรงจาก stock DTB (qcom,mdss_dsi_himax_hx8874_9p06_dsc_cmd)
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_graph.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_crtc.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+#define HX8874_BL_MIN		0x0019	/* 25 */
+#define HX8874_BL_DEFAULT	0x0800	/* 2048 (~30% เชิงเส้น เหมาะสมกับ OLED) */
+#define HX8874_BL_MAX		0x1b20	/* 6944 ตรงตาม stock qcom,mdss-dsi-bl-max-level */
+
+struct hx8874_panel {
+	struct drm_panel panel;
+	struct drm_connector *connector;
+	struct mipi_dsi_device *dsi[2];
+	struct drm_dsc_config dsc;
+	struct gpio_desc *reset_gpio;
+	bool prepared;
+};
+
+static inline struct hx8874_panel *to_hx8874_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct hx8874_panel, panel);
+}
+
+/*
+ * โหมด Bonded Dual-DSI (qcom,sync-dual-dsi) ของ msm_dsi_manager จะสั่งยิงคำสั่ง
+ * ออกทั้ง DSI0 และ DSI1 พร้อมกันเมื่อส่งผ่าน DSI1 (dsi[1])
+ */
+static inline struct mipi_dsi_device *hx8874_trigger_dsi(struct hx8874_panel *ctx)
+{
+	return ctx->dsi[1];
+}
+
+/*
+ * พาเนล 2400x1504 (1200x2 x 1504), ขนาดจริง 195 x 123 มม.
+ * ค่า H-porch ของสต็อกระบุไว้ต่อ 1 ลิงก์ จึงคูณ 2 สำหรับโหมดรวม 2 ลิงก์ของ DRM
+ * ทุกโหมดได้ความถี่ DSI byte clock ~85.1-85.6 MHz (~681 Mbps/lane) ตรงกันทั้งหมด
+ */
+#define HX8874_HDISPLAY		2400
+#define HX8874_VDISPLAY		1504
+#define HX8874_VFP		56
+#define HX8874_VPW		8
+#define HX8874_VBP		8
+#define HX8874_VTOTAL		(HX8874_VDISPLAY + HX8874_VFP + HX8874_VPW + HX8874_VBP)
+
+#define HX8874_MODE(_hfp1, _hpw1, _hbp1, _vrefresh) {				\
+	.clock = ((u64)(HX8874_HDISPLAY + ((_hfp1) + (_hpw1) + (_hbp1)) * 2) *	\
+		  HX8874_VTOTAL * (_vrefresh) + 500) / 1000,			\
+	.hdisplay = HX8874_HDISPLAY,						\
+	.hsync_start = HX8874_HDISPLAY + (_hfp1) * 2,				\
+	.hsync_end = HX8874_HDISPLAY + ((_hfp1) + (_hpw1)) * 2,			\
+	.htotal = HX8874_HDISPLAY + ((_hfp1) + (_hpw1) + (_hbp1)) * 2,		\
+	.vdisplay = HX8874_VDISPLAY,						\
+	.vsync_start = HX8874_VDISPLAY + HX8874_VFP,				\
+	.vsync_end = HX8874_VDISPLAY + HX8874_VFP + HX8874_VPW,			\
+	.vtotal = HX8874_VTOTAL,						\
+	.width_mm = 195,							\
+	.height_mm = 123,							\
+}
+
+/* ลำดับแรก (144 Hz) เป็นค่าเริ่มต้นที่แนะนำ พร้อมรองรับสลับ 165 / 120 / 90 / 60 Hz */
+static const struct drm_display_mode hx8874_modes[] = {
+	HX8874_MODE(32, 8, 40, 144),
+	HX8874_MODE(10, 8, 12, 165),
+	HX8874_MODE(72, 8, 80, 120),
+	HX8874_MODE(152, 160, 12, 90),
+	HX8874_MODE(312, 8, 320, 60),
+};
+
+static const struct drm_dsc_config hx8874_dsc_cfg = {
+	.dsc_version_major = 1,
+	.dsc_version_minor = 1,
+	.slice_height = 4,
+	.slice_width = 1200,
+	.slice_count = 1, /* 1 slice ต่อ 1 ลิงก์ DSI (รวม 2 slices สำหรับ 2400 px) */
+	.bits_per_component = 10,
+	.bits_per_pixel = 8 << 4,
+	.block_pred_enable = true,
+};
+
+/* คำสั่งตั้งค่า DSC 1.1 PPS แบบเฉพาะของ Himax HX8874 (110 ไบต์, Generic Long Write 0x29) */
+static const u8 hx8874_dsc_init_cmd[] = {
+	0x80, 0x90, 0x00, 0x81, 0xe7, 0x03, 0x00, 0x00, 0x00, 0x0a,
+	0x11, 0x00, 0x00, 0xab, 0x30, 0x80, 0x05, 0xe0, 0x09, 0x60,
+	0x00, 0x04, 0x04, 0xb0, 0x04, 0xb0, 0x02, 0x00, 0x03, 0x58,
+	0x00, 0x20, 0x00, 0x72, 0x00, 0x10, 0x00, 0x0c, 0x20, 0x00,
+	0x0b, 0x71, 0x18, 0x00, 0x10, 0xf0, 0x07, 0x10, 0x20, 0x00,
+	0x00, 0x0f, 0x0f, 0x33, 0x0e, 0x1c, 0x2a, 0x38, 0x46, 0x54,
+	0x62, 0x69, 0x70, 0x77, 0x79, 0x7b, 0x7d, 0x7e, 0x02, 0x02,
+	0x22, 0x00, 0x2a, 0x40, 0x2a, 0xbe, 0x3a, 0xfc, 0x3a, 0xfa,
+	0x3a, 0xf8, 0x3b, 0x38, 0x3b, 0x78, 0x3b, 0xb6, 0x4b, 0xf6,
+	0x4c, 0x34, 0x4c, 0x74, 0x5c, 0x74, 0x8c, 0xf4,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00,
+};
+
+static const struct drm_display_mode *hx8874_current_mode(struct hx8874_panel *ctx)
+{
+	const struct drm_display_mode *mode;
+	unsigned int i;
+
+	if (!ctx->connector || !ctx->connector->state ||
+	    !ctx->connector->state->crtc)
+		return &hx8874_modes[0];
+
+	mode = &ctx->connector->state->crtc->state->adjusted_mode;
+	for (i = 0; i < ARRAY_SIZE(hx8874_modes); i++) {
+		if (drm_mode_match(mode, &hx8874_modes[i],
+				   DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_CLOCK))
+			return &hx8874_modes[i];
+	}
+
+	return &hx8874_modes[0];
+}
+
+static u8 hx8874_vrefresh_code(int vrefresh)
+{
+	switch (vrefresh) {
+	case 165:
+		return 0xa5;
+	case 144:
+		return 0x90;
+	case 120:
+		return 0x78;
+	case 90:
+		return 0x5a;
+	case 60:
+		return 0x3c;
+	default:
+		return 0x90;
+	}
+}
+
+static void hx8874_reset(struct hx8874_panel *ctx)
+{
+	/* ลำดับรีเซ็ตตาม stock: physical HIGH 10ms -> LOW 10ms -> HIGH 10ms (active-low GPIO) */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
+static int hx8874_prepare(struct drm_panel *panel)
+{
+	struct hx8874_panel *ctx = to_hx8874_panel(panel);
+	struct mipi_dsi_device *dsi = hx8874_trigger_dsi(ctx);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+	const struct drm_display_mode *mode = hx8874_current_mode(ctx);
+	struct drm_dsc_picture_parameter_set pps;
+	u8 fps = hx8874_vrefresh_code(drm_mode_vrefresh(mode));
+
+	hx8874_reset(ctx);
+
+	/* 1. ส่งตาราง DSC 1.1 PPS เข้าสู่ DDIC และปลุกจอออกจาก Sleep */
+	mipi_dsi_generic_write_multi(&dsi_ctx, hx8874_dsc_init_cmd,
+				     sizeof(hx8874_dsc_init_cmd));
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 240);
+
+	/* 2. ปิดไฟจอก่อนตั้งค่ากรอบภาพ (CASET/PASET) และเปิดสัญญาณ TE */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+				     0x00, 0x00);
+	mipi_dsi_msleep(&dsi_ctx, 150);
+
+	mipi_dsi_dcs_set_column_address_multi(&dsi_ctx, 0x0000, 0x04af);
+	mipi_dsi_dcs_set_page_address_multi(&dsi_ctx, 0x0000, 0x05df);
+	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+
+	/* 3. เปิดการแสดงผลและเลือกรีเฟรชเรตฝั่ง DDIC ให้ตรงกับโหมดปัจจุบัน */
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx,
+					 0x80, 0x8c, 0x00, 0x80, 0xe7,
+					 0xc8, 0x14, 0x01, 0x00);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx,
+					 0x80, 0x8c, 0x00, 0x80, 0xe7,
+					 0x00, 0x00, 0x00, 0x00);
+	mipi_dsi_generic_write_var_seq_multi(&dsi_ctx,
+					     0x80, 0x94, 0x00, 0x80, 0xe7,
+					     fps, 0x00, 0x01, 0x00);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx,
+					 0x80, 0x78, 0x00, 0xac, 0xe7,
+					 0x3c, 0x78, 0x82, 0x90);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx,
+					 0x80, 0xa0, 0x00, 0x80, 0xe7,
+					 0x04, 0x00, 0x00, 0x00);
+
+	/*
+	 * ปรับค่า range_max_qp[0] ของ DPU DSC encoder เป็น 8 ให้ตรงกับตาราง PPS
+	 * ของ HX8874 (ตาราง VESA pre-SCR ใน drm_dsc_helper ตั้งเป็น 4)
+	 */
+	ctx->dsc.rc_range_params[0].range_max_qp = 8;
+	if (!dsi_ctx.accum_err)
+		dsi_ctx.accum_err = drm_dsc_compute_rc_parameters(&ctx->dsc);
+
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+
+	if (dsi_ctx.accum_err) {
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		return dsi_ctx.accum_err;
+	}
+
+	ctx->prepared = true;
+	return 0;
+}
+
+static int hx8874_unprepare(struct drm_panel *panel)
+{
+	struct hx8874_panel *ctx = to_hx8874_panel(panel);
+	struct mipi_dsi_device *dsi = hx8874_trigger_dsi(ctx);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+
+	ctx->prepared = false;
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 100);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 100);
+
+	if (dsi_ctx.accum_err)
+		dev_err(&ctx->dsi[0]->dev, "ส่งคำสั่งปิดจอ HX8874 ล้มเหลว: %d\n",
+			dsi_ctx.accum_err);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	return 0;
+}
+
+static int hx8874_get_modes(struct drm_panel *panel,
+			    struct drm_connector *connector)
+{
+	struct hx8874_panel *ctx = to_hx8874_panel(panel);
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(hx8874_modes); i++) {
+		struct drm_display_mode *mode;
+
+		mode = drm_mode_duplicate(connector->dev, &hx8874_modes[i]);
+		if (!mode)
+			return -ENOMEM;
+
+		mode->type = DRM_MODE_TYPE_DRIVER;
+		if (i == 0)
+			mode->type |= DRM_MODE_TYPE_PREFERRED;
+
+		drm_mode_set_name(mode);
+		drm_mode_probed_add(connector, mode);
+	}
+
+	connector->display_info.width_mm = hx8874_modes[0].width_mm;
+	connector->display_info.height_mm = hx8874_modes[0].height_mm;
+	connector->display_info.bpc = hx8874_dsc_cfg.bits_per_component;
+	ctx->connector = connector;
+
+	return ARRAY_SIZE(hx8874_modes);
+}
+
+static const struct drm_panel_funcs hx8874_panel_funcs = {
+	.prepare = hx8874_prepare,
+	.unprepare = hx8874_unprepare,
+	.get_modes = hx8874_get_modes,
+};
+
+static int hx8874_bl_update_status(struct backlight_device *bl)
+{
+	struct hx8874_panel *ctx = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+
+	if (!ctx->prepared)
+		return 0;
+
+	if (brightness > 0 && brightness < HX8874_BL_MIN)
+		brightness = HX8874_BL_MIN;
+
+	return mipi_dsi_dcs_set_display_brightness_large(hx8874_trigger_dsi(ctx),
+							 brightness);
+}
+
+static const struct backlight_ops hx8874_bl_ops = {
+	.update_status = hx8874_bl_update_status,
+};
+
+static struct backlight_device *hx8874_create_backlight(struct hx8874_panel *ctx)
+{
+	struct device *dev = &ctx->dsi[0]->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = HX8874_BL_DEFAULT,
+		.max_brightness = HX8874_BL_MAX,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, ctx,
+					      &hx8874_bl_ops, &props);
+}
+
+static int hx8874_probe(struct mipi_dsi_device *dsi)
+{
+	struct mipi_dsi_device_info dsi_info = { "hx8874-secondary", 0, NULL };
+	struct mipi_dsi_host *dsi1_host;
+	struct device *dev = &dsi->dev;
+	struct device_node *dsi1;
+	struct hx8874_panel *ctx;
+	int ret, i;
+
+	ctx = devm_drm_panel_alloc(dev, struct hx8874_panel, panel,
+				   &hx8874_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "ไม่พบ reset-gpios ของจอ HX8874\n");
+
+	ctx->dsc = hx8874_dsc_cfg;
+
+	dsi1 = of_graph_get_remote_node(dsi->dev.of_node, 1, -1);
+	if (!dsi1) {
+		dev_err(dev, "ไม่พบโหนด secondary DSI (port@1)\n");
+		return -ENODEV;
+	}
+
+	dsi1_host = of_find_mipi_dsi_host_by_node(dsi1);
+	of_node_put(dsi1);
+	if (!dsi1_host)
+		return dev_err_probe(dev, -EPROBE_DEFER,
+				     "รอ secondary DSI host พร้อมทำงาน\n");
+
+	ctx->dsi[1] = devm_mipi_dsi_device_register_full(dev, dsi1_host, &dsi_info);
+	if (IS_ERR(ctx->dsi[1]))
+		return PTR_ERR(ctx->dsi[1]);
+
+	ctx->dsi[0] = dsi;
+	mipi_dsi_set_drvdata(ctx->dsi[0], ctx);
+	mipi_dsi_set_drvdata(ctx->dsi[1], ctx);
+
+	ctx->panel.prepare_prev_first = true;
+	ctx->panel.backlight = hx8874_create_backlight(ctx);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "สร้างอุปกรณ์ปรับความสว่างไม่สำเร็จ\n");
+
+	ret = devm_drm_panel_add(dev, &ctx->panel);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "ลงทะเบียน drm_panel ไม่สำเร็จ\n");
+
+	for (i = 0; i < 2; i++) {
+		ctx->dsi[i]->lanes = 4;
+		ctx->dsi[i]->format = MIPI_DSI_FMT_RGB101010;
+		/* Command Mode + Non-Continuous Clock + LPM สำหรับคำสั่งควบคุม */
+		ctx->dsi[i]->mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS |
+					  MIPI_DSI_MODE_LPM;
+		ctx->dsi[i]->dsc = &ctx->dsc;
+		ret = devm_mipi_dsi_attach(dev, ctx->dsi[i]);
+		if (ret < 0)
+			return dev_err_probe(dev, ret,
+					     "เชื่อมต่อ DSI%d ล้มเหลว\n", i);
+	}
+
+	return 0;
+}
+
+static const struct of_device_id hx8874_of_match[] = {
+	{ .compatible = "himax,hx8874-9p06" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, hx8874_of_match);
+
+static struct mipi_dsi_driver hx8874_driver = {
+	.probe = hx8874_probe,
+	.driver = {
+		.name = "panel-himax-hx8874",
+		.of_match_table = hx8874_of_match,
