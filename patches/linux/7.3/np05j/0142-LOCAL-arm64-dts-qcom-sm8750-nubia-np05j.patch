@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Copyright (c) 2026 Project Silicium / nubia NP05J (REDMAGIC Astra) bring-up
+ *
+ * Full Desktop Device Tree: Adreno 830v2 GPU (headless renderD128 คู่กับ UEFI GOP
+ * simpledrm) + USB-C Dual-Role (OTG + USB 3.0 ผ่าน pmic-glink/ADSP) + Wi-Fi 7 + BT + Touch.
+ */
+
+/dts-v1/;
+
+#include "sm8750-nubia-np05j-common.dtsi"
+
+&gpu {
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/gen80000_zap.mbn";
+};
+
+&pmic_glink {
+	orientation-gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>;
+
+	connector@0 {
+		compatible = "usb-c-connector";
+		reg = <0>;
+
