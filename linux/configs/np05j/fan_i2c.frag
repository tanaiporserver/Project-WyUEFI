# REDMAGIC Astra Active Cooling Fan (PM8550 LPG PWM ch3 + pwm-fan + hwmon tach)
CONFIG_PWM=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_QCOM_PBS=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_HWMON=y
CONFIG_SENSORS_PWM_FAN=y

# Audio (TFA98xx @0x34/0x35) & RGB LED (AW22xxx @0x6a) I2C Hub 3
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_QCOM_GENI=y
