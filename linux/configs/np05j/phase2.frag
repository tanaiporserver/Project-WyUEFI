# Networking (lean IPv4 + BBR/FQ + QRTR + Wi-Fi 7 + BT)
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
CONFIG_IPV6=n
CONFIG_NETFILTER=n
CONFIG_NETDEVICES=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_ATH12K=y
CONFIG_ATH12K_DEBUG=n
CONFIG_ATH12K_DEBUGFS=n
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_MHI=y

# PCIe0 + QMP PCIe PHY + WCN785x/Peach Power Sequencing + MHI (for ath12k)
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIE_DW=y
CONFIG_PCIE_DW_HOST=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_PCI_PWRCTRL=y
CONFIG_PCI_PWRCTRL_PWRSEQ=y
CONFIG_MHI_BUS=y

# Bluetooth (UART14 QUPv3 GENI + serdev + HCI_QCA WCN785x/Peach)
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=y

# Remoteproc (ADSP + CDSP / Hexagon HTP NPU) + FastRPC + SMP2P + GLINK + In-Kernel PD-Mapper
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_PAGED_BUF=y
CONFIG_FW_LOADER_COMPRESS=n
CONFIG_REMOTEPROC=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMEM_STATE=y
CONFIG_RPMSG=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_CTRL=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_FASTRPC=y

# Battery (pmic_glink + qcom_battmgr) & USB-C Type-C Dual-Role / Host / OTG + USB 3.0 SuperSpeed
CONFIG_POWER_SUPPLY=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_BATTERY_QCOM_BATTMGR=y
CONFIG_UCSI_PMIC_GLINK=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_DWC3_GADGET=n
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_STORAGE=y

# Touchscreen SPI4 bus (QUPv3 GENI SPI FIFO + spidev + GPIO sysfs/chardev)
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_SPI_SPIDEV=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_CDEV_V1=y
CONFIG_GPIO_SYSFS=y


# Parent dependencies for QCOM_PMIC_GLINK (DRM bridge core only, NO DRM display drivers!) and USB_HID
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=n
CONFIG_DRM_SIMPLEDRM=n
CONFIG_DRM_MSM=n
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_BATTERY_QCOM_BATTMGR=y
CONFIG_UCSI_PMIC_GLINK=y
